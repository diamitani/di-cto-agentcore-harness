# DI-CTO AgentCore Environment Variables
# Copy to .env and fill in real values (never commit .env)

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=diamitani-dev
# AWS_ACCESS_KEY_ID=ENV:AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=ENV:AWS_SECRET_ACCESS_KEY

# Bedrock AgentCore
BEDROCK_AGENT_ID=your-agent-id
BEDROCK_AGENT_ALIAS=prod

# LLM Fallback Providers (for BYOK mode)
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=structured

# Memory
MEMORY_PROVIDER=bedrock
MEMORY_TABLE=di-cto-memories

# Observability
ENABLE_CLOUDWATCH=true
ENABLE_XRAY=true
METRICS_NAMESPACE=DI-CTO

# GitHub
GITHUB_TOKEN=ENV:GITHUB_TOKEN
GITHUB_ORG=diamitani-industries

# Secrets (references only, never raw values)
SECRETS_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:di-cto
