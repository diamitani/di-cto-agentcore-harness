# Vercel AI SDK & Gateway Configuration
AI_PROVIDER=bedrock # bedrock | anthropic | openai | mock
AI_MODEL=us.anthropic.claude-sonnet-4-6-v1:0

# AWS Bedrock Credentials (Optional - Mock mode active if empty)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Anthropic Direct (Optional)
ANTHROPIC_API_KEY=

# OpenAI (Optional)
OPENAI_API_KEY=

# ROSTR Framework Settings
ROSTR_ENV=production
ROSTR_VERSION=1.0.0
ROSTR_TELEMETRY=enabled
